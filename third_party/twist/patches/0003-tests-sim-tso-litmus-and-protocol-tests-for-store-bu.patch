diff --git a/tests/sim/tso/replay.cpp b/tests/sim/tso/replay.cpp
new file mode 100644
index 00000000..4ea4829f
--- /dev/null
+++ b/tests/sim/tso/replay.cpp
@@ -0,0 +1,82 @@
+#include "explore.hpp"
+
+#include <twist/ed/std/atomic.hpp>
+#include <twist/ed/std/thread.hpp>
+
+#include <twist/assist/assert.hpp>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <fmt/core.h>
+
+#include <utility>
+
+// Flush choices are scheduler decisions:
+// recorded by Recorder and reproduced by ReplayScheduler
+
+// SB litmus: TWIST_ASSERT fails on r0 = r1 = 0
+static void StoreBufferingAssert() {
+  twist::ed::std::atomic<int> x{0};
+  twist::ed::std::atomic<int> y{0};
+
+  int r0 = -1;
+  int r1 = -1;
+
+  twist::ed::std::thread t1([&] {
+    x.store(1, std::memory_order::relaxed);
+    r0 = y.load(std::memory_order::relaxed);
+  });
+
+  twist::ed::std::thread t2([&] {
+    y.store(1, std::memory_order::relaxed);
+    r1 = x.load(std::memory_order::relaxed);
+  });
+
+  t1.join();
+  t2.join();
+
+  TWIST_ASSERT_M(!(r0 == 0 && r1 == 0), "Store -> load reordering");
+}
+
+TEST_CASE("Replay flush choices") {
+  auto sim_params = tso::SimParams(true);
+  // Make digest sensitive to loaded values
+  sim_params.digest_atomic_loads = true;
+
+  twist::sim::sched::RandomScheduler random{{.seed = 17}};
+
+  size_t failures = 0;
+  size_t passes = 0;
+
+  for (size_t i = 0; i < 256; ++i) {
+    auto [schedule, recorded] = [&] {
+      twist::sim::sched::Recorder recorder{&random};
+      twist::sim::Simulator sim{&recorder, sim_params};
+      auto result = sim.Run(StoreBufferingAssert);
+      return std::pair{recorder.GetSchedule(), result};
+    }();
+
+    if (recorded.Ok()) {
+      ++passes;
+    } else {
+      ++failures;
+    }
+
+    {
+      twist::sim::sched::ReplayScheduler replay{schedule};
+      twist::sim::Simulator sim{&replay, sim_params};
+      auto replayed = sim.Run(StoreBufferingAssert);
+
+      REQUIRE(replayed.status == recorded.status);
+      REQUIRE(replayed.digest == recorded.digest);
+      REQUIRE(replayed.std_err == recorded.std_err);
+    }
+
+    random.NextSchedule();
+  }
+
+  fmt::println("Replay: {} passed / {} failed simulations reproduced", passes, failures);
+
+  REQUIRE(failures > 0);
+  REQUIRE(passes > 0);
+}
diff --git a/tests/sim/tso/wake.cpp b/tests/sim/tso/wake.cpp
new file mode 100644
index 00000000..b6c5394b
--- /dev/null
+++ b/tests/sim/tso/wake.cpp
@@ -0,0 +1,126 @@
+#include "explore.hpp"
+
+#include <twist/ed/std/atomic.hpp>
+#include <twist/ed/std/thread.hpp>
+#include <twist/ed/wait/futex.hpp>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <fmt/core.h>
+
+// Dekker-style wake-up protocol:
+//
+// Consumer: sleeping = true; [fence]; if (!ready) { wait }
+// Producer: ready = true; [fence]; if (sleeping) { wake }
+//
+// Without seq_cst fences both loads may miss the stores
+// (still in store buffers) => lost wake-up => deadlock
+
+static void WakeProtocol(bool fences) {
+  twist::ed::std::atomic<uint32_t> epoch{0};
+  twist::ed::std::atomic<bool> sleeping{false};
+  twist::ed::std::atomic<bool> ready{false};
+
+  auto fence = [fences] {
+    if (fences) {
+      twist::ed::std::atomic_thread_fence(std::memory_order::seq_cst);
+    }
+  };
+
+  twist::ed::std::thread consumer([&] {
+    uint32_t e = epoch.load(std::memory_order::relaxed);
+
+    sleeping.store(true, std::memory_order::relaxed);
+    fence();
+    if (!ready.load(std::memory_order::relaxed)) {
+      // Until epoch != e
+      twist::ed::futex::Wait(epoch, e, std::memory_order::relaxed);
+    }
+  });
+
+  twist::ed::std::thread producer([&] {
+    ready.store(true, std::memory_order::relaxed);
+    fence();
+    if (sleeping.load(std::memory_order::relaxed)) {
+      auto wake_key = twist::ed::futex::PrepareWake(epoch);
+      epoch.fetch_add(1, std::memory_order::relaxed);
+      twist::ed::futex::WakeOne(wake_key);
+    }
+  });
+
+  consumer.join();
+  producer.join();
+}
+
+static void Report(const char* name, const tso::Stat& stat) {
+  fmt::println("{}: simulations = {}, failures = {}", name, stat.sims, stat.failures);
+  if (stat.failure) {
+    REQUIRE(stat.failure->status == twist::sim::Status::Deadlock);
+  }
+}
+
+TEST_CASE("Wake protocol: Random") {
+  static const size_t kSims = 1000;
+
+  SECTION("No fences / store buffering off") {
+    auto stat = tso::Random(tso::SimParams(false), [] { WakeProtocol(false); }, kSims);
+    Report("Random, no fences, SC", stat);
+    REQUIRE(stat.Ok());
+  }
+
+  SECTION("No fences") {
+    auto stat = tso::Random(tso::SimParams(true), [] { WakeProtocol(false); }, kSims);
+    Report("Random, no fences, TSO", stat);
+    REQUIRE(!stat.Ok());
+  }
+
+  SECTION("Fences") {
+    auto stat = tso::Random(tso::SimParams(true), [] { WakeProtocol(true); }, kSims);
+    Report("Random, fences, TSO", stat);
+    REQUIRE(stat.Ok());
+  }
+}
+
+TEST_CASE("Wake protocol: PCT") {
+  static const size_t kSims = 1000;
+
+  SECTION("No fences / store buffering off") {
+    auto stat = tso::Pct(tso::SimParams(false), [] { WakeProtocol(false); }, kSims);
+    Report("PCT, no fences, SC", stat);
+    REQUIRE(stat.Ok());
+  }
+
+  SECTION("No fences") {
+    auto stat = tso::Pct(tso::SimParams(true), [] { WakeProtocol(false); }, kSims);
+    Report("PCT, no fences, TSO", stat);
+    REQUIRE(!stat.Ok());
+  }
+
+  SECTION("Fences") {
+    auto stat = tso::Pct(tso::SimParams(true), [] { WakeProtocol(true); }, kSims);
+    Report("PCT, fences, TSO", stat);
+    REQUIRE(stat.Ok());
+  }
+}
+
+TEST_CASE("Wake protocol: DFS") {
+  SECTION("No fences / store buffering off") {
+    auto stat = tso::Dfs(tso::SimParams(false), [] { WakeProtocol(false); });
+    Report("DFS, no fences, SC", stat);
+    REQUIRE(stat.Ok());
+    REQUIRE(stat.pruned == 0);
+  }
+
+  SECTION("No fences") {
+    auto stat = tso::Dfs(tso::SimParams(true), [] { WakeProtocol(false); });
+    Report("DFS, no fences, TSO", stat);
+    REQUIRE(!stat.Ok());
+  }
+
+  SECTION("Fences") {
+    auto stat = tso::Dfs(tso::SimParams(true), [] { WakeProtocol(true); });
+    Report("DFS, fences, TSO", stat);
+    REQUIRE(stat.Ok());
+    REQUIRE(stat.pruned == 0);
+  }
+}
