+ private:
+  // Store buffers
+
+  void BufferStore(Thread* writer, AtomicVar* atomic, Action* store) {
+    StoreBuffer& buffer = writer->sync.store_buffer;
+
+    if (buffer.Size() == store_buffer_capacity_) {
+      // Overflow
+      FlushStoreBuffer(writer, 1);
+    }
+
+    if (buffer.IsEmpty()) {
+      RegisterStoreBuffer(writer);
+    }
+
+    BufferedStore& pending = buffer.Push(store_buffer_capacity_);
+
+    pending.atomic = atomic;
+    pending.value = store->value;
+    // See AtomicStore{Release,Relaxed}
+    if (IsReleaseOrder(store->mo)) {
+      pending.clock.Assign(writer->sync.clock.current);
+    } else {
+      pending.clock.Assign(writer->sync.clock.release_fence);
+    }
+  }
+
+  // Flush `count` oldest pending stores of the writer to memory
+  void FlushStoreBuffer(Thread* writer, size_t count) {
+    if (count == 0) {
+      return;
+    }
+
+    StoreBuffer& buffer = writer->sync.store_buffer;
+
+    for (size_t i = 0; i < count; ++i) {
+      BufferedStore& pending = buffer.Front();
+      pending.atomic->last_write.value = pending.value;
+      pending.atomic->last_write.clock.Assign(pending.clock);
+      buffer.PopFront();
+    }
+
+    if (buffer.IsEmpty()) {
+      UnregisterStoreBuffer(writer);
+    }
+  }
