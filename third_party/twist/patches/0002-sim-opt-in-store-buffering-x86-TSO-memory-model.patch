diff --git a/library/sim/source/twist/rt/sim/system/sync/store_buffer.hpp b/library/sim/source/twist/rt/sim/system/sync/store_buffer.hpp
new file mode 100644
index 00000000..c5451472
--- /dev/null
+++ b/library/sim/source/twist/rt/sim/system/sync/store_buffer.hpp
@@ -0,0 +1,101 @@
+#pragma once
+
+#include "atomic.hpp"
+#include "clock.hpp"
+
+#include <twist/detail/assert.hpp>
+
+#include <cstdint>
+#include <cstdlib>
+#include <optional>
+#include <vector>
+
+namespace twist::rt::sim {
+
+namespace system::sync {
+
+// x86-TSO store buffer
+// https://www.cl.cam.ac.uk/~pes20/weakmemory/cacm.pdf
+
+struct BufferedStore {
+  AtomicVar* atomic;
+  uint64_t value;
+  // Release clock of the writer captured at the store
+  VectorClock clock;
+  // Number of loads from other threads that have not observed this store
+  size_t skips;
+};
+
+// Per-thread FIFO of pending stores (bounded ring)
+
+class StoreBuffer {
+ public:
+  void Init() {
+    head_ = 0;
+    size_ = 0;
+  }
+
+  bool IsEmpty() const {
+    return size_ == 0;
+  }
+
+  size_t Size() const {
+    return size_;
+  }
+
+  size_t Capacity() const {
+    return slots_.size();
+  }
+
+  // 0 - oldest
+  BufferedStore& operator[](size_t index) {
+    return slots_[(head_ + index) % slots_.size()];
+  }
+
+  const BufferedStore& operator[](size_t index) const {
+    return slots_[(head_ + index) % slots_.size()];
+  }
+
+  // Precondition: Size() < capacity
+  BufferedStore& Push(size_t capacity) {
+    if (slots_.size() != capacity) {
+      TWIST_INTERNAL_ASSERT(size_ == 0, "Non-empty store buffer resized");
+      slots_.resize(capacity);
+      head_ = 0;
+    }
+
+    TWIST_INTERNAL_ASSERT(size_ < slots_.size(), "Store buffer overflow");
+
+    BufferedStore& slot = (*this)[size_++];
+    slot.skips = 0;
+    return slot;
+  }
+
+  BufferedStore& Front() {
+    return (*this)[0];
+  }
+
+  void PopFront() {
+    head_ = (head_ + 1) % slots_.size();
+    --size_;
+  }
+
+  // Store-to-load forwarding: index of the youngest store to `atomic`
+  std::optional<size_t> FindLatest(const AtomicVar* atomic) const {
+    for (size_t i = size_; i > 0; --i) {
+      if ((*this)[i - 1].atomic == atomic) {
+        return i - 1;
+      }
+    }
+    return std::nullopt;
+  }
+
+ private:
+  std::vector<BufferedStore> slots_;
+  size_t head_ = 0;
+  size_t size_ = 0;
+};
+
+}  // namespace system::sync
+
+}  // namespace twist::rt::sim
