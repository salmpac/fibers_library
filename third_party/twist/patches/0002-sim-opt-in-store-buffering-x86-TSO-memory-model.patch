+  // Before `reader` loads `atomic` from memory, pending stores to `atomic`
+  // from other threads may be flushed (with all older stores from the same
+  // buffers). Choice 0 – keep them pending, choice i – flush buffer up to i-th
+  // candidate
+  void FlushBeforeLoad(Thread* reader, AtomicVar* atomic) {
+    if (pending_store_buffers_ == 0) {
+      return;  // Fast path
+    }
+
+    while (true) {
+      CollectPendingStores(reader, atomic);
+
+      if (candidates_.empty()) {
+        return;
+      }
+
+      size_t choice = scheduler_->RandomChoice(candidates_.size() + 1);
+
+      if (choice == 0) {
+        // Load misses all pending stores
+        for (auto [writer, index] : candidates_) {
+          ++writer->sync.store_buffer[index].skips;
+        }
+        return;
+      }
+
+      auto [writer, index] = candidates_[choice - 1];
+      FlushStoreBuffer(writer, index + 1);
+    }
+  }
+
+  // Reader has pending store to `atomic` at index `own` in its buffer.
+  // Pending stores to `atomic` from other threads may still be ordered after
+  // it: choice 0 – forward own store, choice i – flush own buffer up to `own`
+  // and then other buffer up to i-th candidate
+  bool FlushOwnBeforeLoad(Thread* reader, AtomicVar* atomic, size_t own) {
+    if (pending_store_buffers_ < 2) {
+      return false;  // Fast path
+    }
+
+    CollectPendingStores(reader, atomic);
+
+    if (candidates_.empty()) {
+      return false;
+    }
+
+    size_t choice = scheduler_->RandomChoice(candidates_.size() + 1);
+
+    if (choice == 0) {
+      for (auto [writer, index] : candidates_) {
+        ++writer->sync.store_buffer[index].skips;
+      }
+      return false;
+    }
+
+    auto [writer, index] = candidates_[choice - 1];
+
+    FlushStoreBuffer(reader, own + 1);
+    FlushStoreBuffer(writer, index + 1);
+
+    return true;
+  }
