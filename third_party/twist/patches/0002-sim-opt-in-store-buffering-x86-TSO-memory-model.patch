+  // Candidates for FlushBeforeLoad in deterministic order
+  void CollectPendingStores(Thread* reader, AtomicVar* atomic) {
+    candidates_.clear();
+
+    for (Thread* writer : store_buffers_) {
+      if ((writer == nullptr) || (writer == reader)) {
+        continue;
+      }
+
+      StoreBuffer& buffer = writer->sync.store_buffer;
+
+      {
+        // Eventual visibility: do not let a store be missed forever
+        // (e.g. by a spinning reader under DFS)
+
+        size_t starved = 0;
+        for (size_t i = 0; i < buffer.Size(); ++i) {
+          if ((buffer[i].atomic == atomic) &&
+              (buffer[i].skips >= store_buffer_max_skips_)) {
+            starved = i + 1;
+          }
+        }
+        FlushStoreBuffer(writer, starved);
+      }
+
+      for (size_t i = 0; i < buffer.Size(); ++i) {
+        if (buffer[i].atomic == atomic) {
+          candidates_.emplace_back(writer, i);
+        }
+      }
+    }
+  }
+
+  void FlushStoresTo(AtomicVar* atomic) {
+    for (Thread* writer : store_buffers_) {
+      if (writer == nullptr) {
+        continue;
+      }
+
+      StoreBuffer& buffer = writer->sync.store_buffer;
+
+      size_t last = 0;
+      for (size_t i = 0; i < buffer.Size(); ++i) {
+        if (buffer[i].atomic == atomic) {
+          last = i + 1;
+        }
+      }
+      FlushStoreBuffer(writer, last);
+    }
+  }
