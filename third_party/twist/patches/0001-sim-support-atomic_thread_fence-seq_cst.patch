From 84a941cc2cb81207c00310bc8460bc76206896dd Mon Sep 17 00:00:00 2001
From: Sergey Dushenkov <ss.dushenkov@gmail.com>
Date: Wed, 4 Nov 2026 23:06:08 +0300
Subject: [PATCH 1/5] sim: support atomic_thread_fence(seq_cst)

The simulator panicked with "Fence not supported" on seq_cst fences,
so code using them (e.g. Dekker-style sleep / wake-up protocols) could
not be simulated without patching the fences under __TWIST_SIM__.

Atomic values are sequentially consistent in the simulator anyway,
so for happens-before tracking a seq_cst fence is an acq_rel fence.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0174gihuXWLUfMwAE3xin9ru
---
 library/sim/source/twist/rt/sim/system/sync/model.hpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/library/sim/source/twist/rt/sim/system/sync/model.hpp b/library/sim/source/twist/rt/sim/system/sync/model.hpp
index dd7aa6ed..78109336 100644
--- a/library/sim/source/twist/rt/sim/system/sync/model.hpp
+++ b/library/sim/source/twist/rt/sim/system/sync/model.hpp
@@ -319,6 +319,12 @@ class SeqCstMemoryModel {
     AtomicThreadFenceRelease(thread);
   }
 
+  void AtomicThreadFenceSeqCst(Thread* thread) {
+    // Happens-before: total order of seq_cst fences
+    // is not tracked, values are sequentially consistent anyway
+    AtomicThreadFenceAcqRel(thread);
+  }
+
   void AtomicThreadFence(Thread* thread, Action* fence) {
     switch (fence->mo) {
       case std::memory_order::acquire:
@@ -330,6 +336,9 @@ class SeqCstMemoryModel {
       case std::memory_order::acq_rel:
         AtomicThreadFenceAcqRel(thread);
         return;
+      case std::memory_order::seq_cst:
+        AtomicThreadFenceSeqCst(thread);
+        return;
       default:
         TWIST_INTERNAL_PANIC("Fence not supported");
     }
